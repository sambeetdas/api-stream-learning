{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch SseApi (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net9.0/SseApi.dll",
      "args": ["--urls", "http://localhost:5099"],
      "cwd": "${workspaceFolder}",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)"
      },
      "console": "internalConsole"
    },
    {
      "name": "Attach to running app",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
